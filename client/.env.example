# Copy to .env.local for `npm run dev`, or set these in Vercel → Settings →
# Environment Variables. Server-side only: never prefix them with VITE_.

# Turns on AI scanning. Leave empty for free on-device OCR only.
LLM_API_KEY=

# Any OpenAI-compatible endpoint + a vision-capable model.
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1073

# ocr  = never use the LLM
# auto = on-device OCR first, LLM only when items don't add up (default)
# llm  = always use the LLM, OCR as backup
SCAN_MODE=auto

# AI scans allowed per IP address per hour.
SCAN_RATE_LIMIT=20
