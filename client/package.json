    "axios": "^1.10.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.1.8",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
