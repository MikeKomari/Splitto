{
  "name": "splitto-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
